{
  "name": "subhro-backend",
  "version": "1.0.0",
  "description": "Backend for SocializeNow",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "start:workers": "node -r dotenv/config src/workers/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "keywords": [
    "javascript",
    "backend",
    "socializeNow"
  ],
  "author": "Subhrojyoti Das",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "pg": "^8.22.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
